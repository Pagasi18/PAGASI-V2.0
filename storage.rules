rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Antes: cualquier sesion autenticada (incluida la anonima del formulario
    // publico) podia leer y escribir TODO el Storage -- donde se guardan cedulas,
    // documentos de motos, etc. Ahora solo el staff real (sesion no anonima con
    // ficha en /usuarios) tiene acceso.
    match /{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }

    // Comprobantes de pago que sube el cliente desde el portal (micuenta.html).
    // La sesion del cliente vive en Firestore (sesiones_cliente); aqui se
    // verifica que la carpeta sea exactamente la suya. Solo imagenes o PDF,
    // maximo 8 MB. El cliente NO puede leer la carpeta de otro.
    match /comprobantes/{clienteId}/{fileName} {
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/sesiones_cliente/$(request.auth.uid)).data.clienteId == clienteId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow read: if request.auth != null
        && (
          ( request.auth.token.firebase.sign_in_provider != 'anonymous'
            && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) )
          || firestore.get(/databases/(default)/documents/sesiones_cliente/$(request.auth.uid)).data.clienteId == clienteId
        );
    }
  }
}
